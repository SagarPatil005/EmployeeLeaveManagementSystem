<?xml version="1.0" encoding="UTF-8"?>

<hibernate-mapping>
	<class name="com.elms.Models.Employee" table="employee">
		<id name="emp_id" column="Emp_id">
		</id>

		<property name="name" column="Name"></property>
		<property name="email" column="Email"></property>
		<property name="mobile_no" column="MobileNo"></property>
		<property name="department" column="Department"></property>
		<property name="joining_date" column="Joining_date"></property>
		<property name="status" column="status"></property>
		<property name="user_id" column="User_id"></property>

		<set name="leaveRequests" inverse="true" lazy="true">

			<key column="emp_id" />

			<one-to-many class="com.elms.Models.LeaveRequest" />

		</set>

	</class>
</hibernate-mapping>